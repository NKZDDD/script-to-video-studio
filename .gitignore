# 密钥与本地配置（绝不提交）
config.json
legacy/config.legacy.json
config.local.*
*.key
.env
.env.*
secrets.*

# 生产产物（体积大，另行备份）
projects/
output/
outputs/

# 打包产物（140 MB 的 exe，别进仓库；要发版就传 Release）
dist/
build/
*.spec
# 打包依赖（pip --target 装的，沙箱不让写全局 site-packages 时的本地安装位）
.deps/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
*.log
*.tmp

# 剧本原稿不入库：是客户资产，且体量大、变动频繁
*.docx
*.doc
*.pdf
*.txt
!requirements.txt
